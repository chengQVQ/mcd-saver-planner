# MCP Token 配置示例
#
# 使用方法（零依赖，无需 npm install）：
#   1. 复制本文件为 .env：      cp .env.example .env   （Windows: copy .env.example .env）
#   2. 用编辑器打开 .env，把下面的 YOUR_MCP_TOKEN_HERE 替换成你的真实 Token
#   3. 运行 node src/index.js
#
# ⚠️ .env 已被 .gitignore 忽略，可安全存放本地 Token，切勿提交到仓库。
# ⚠️ 优先级：命令行环境变量 > .env 文件
#
# 麦当劳 MCP Token 申请地址：https://open.mcd.cn/mcp/doc（右上角【控制台】→【激活】）

MCP_TOKEN=YOUR_MCP_TOKEN_HERE

# MCP Server 地址（一般无需修改）
MCD_MCP_URL=https://mcp.mcd.cn

# 日志级别：ERROR | WARN | INFO | DEBUG
LOG_LEVEL=INFO

# 可选：限流与重试调优
# MCD_RATE_LIMIT=600
# MCD_MAX_RETRY=3
# MCD_RETRY_DELAY=1000
# MCD_REQUEST_TIMEOUT=15000
