# MCP Token 配置示例
#
# ⚠️ 本文件仅为占位符示例，严禁提交真实 Token 到代码仓库。
# 复制为 .env 并填入你自己的 Token，或直接使用环境变量注入。

# 麦当劳 MCP Token（在 https://open.mcd.cn 控制台申请）
MCP_TOKEN=YOUR_MCP_TOKEN_HERE

# MCP Server 地址（一般无需修改）
MCD_MCP_URL=https://mcp.mcd.cn

# 日志级别：ERROR | WARN | INFO | DEBUG
LOG_LEVEL=INFO

# 可选：限流与重试调优
# MCD_RATE_LIMIT=600
# MCD_MAX_RETRY=3
# MCD_RETRY_DELAY=1000
# MCD_REQUEST_TIMEOUT=15000
